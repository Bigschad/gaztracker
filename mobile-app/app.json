{
  "expo": {
    "name": "GazTracker Mobile",
    "slug": "gaztracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gaztracker.mobile",
      "infoPlist": {
        "NFCReaderUsageDescription": "Cette application utilise NFC pour scanner les tags RFID des palettes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gaztracker.mobile",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "usesFeature": [
        "android.hardware.nfc"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/notification-sound.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser l'accès à la localisation pour le suivi des expéditions."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'accès à la caméra pour prendre des photos des palettes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "001"
      },
      "apiUrl": "http://192.168.1.4:8000"
    }
  }
}

